# Production Environment Configuration Template

# Database Configuration
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_random_db_password

# Google Gemini API Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Security
JWT_SECRET_KEY=generate_a_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated origins, or http://your-ec2-ip)
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Frontend Build Variables (Relative paths for Nginx reverse proxy)
VITE_API_URL=/api
VITE_BACKEND_URL=
