# Production Environment Configuration Template

# Database Configuration
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here
DATABASE_URL=postgresql://postgres:your_strong_db_password_here@postgres:5432/rag_db

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here

# JWT Security
JWT_SECRET_KEY=generate_a_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost

# Frontend Build Variables
VITE_API_URL=https://yourdomain.com/api
VITE_BACKEND_URL=https://yourdomain.com
